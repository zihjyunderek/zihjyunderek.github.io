---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { SITE } from '../../config';

const title = `Contact – ${SITE.shortName}`;
const description =
  'Contact Zih-Jyun (Derek) Huang (黃子竣) for urban analytics, spatial econometrics, quantitative risk, and research collaborations.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: new URL('/contact/', SITE.url).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[breadcrumbLd]}>
  <header class="wrap rail page-head">
    <div class="rail-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Contact</span>
      </nav>
      <h1>Contact</h1>
    </div>
  </header>

  <Section title="Channels">
    <ul class="contact-list">
      <li><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><strong>GitHub:</strong> <a href={SITE.github} target="_blank" rel="noopener noreferrer">{SITE.github.replace('https://', '')}</a></li>
      {SITE.linkedin && (
        <li><strong>LinkedIn:</strong> <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">{SITE.linkedin.replace('https://www.', '').replace(/\/$/, '')}</a></li>
      )}
      <li><strong>CV:</strong> <a href="/cv/ZihJyunHuang_CV_en.pdf" target="_blank" rel="noopener">One-page CV (PDF)</a></li>
    </ul>
  </Section>
</Base>

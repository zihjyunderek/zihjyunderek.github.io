---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, DOMAINS, PERSON_ID } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
// contents in the rail: the opening paragraphs, then each section
const sections = headings.filter((h) => h.depth === 2);
const { title, tagline, domain, stack, stats, repo, status } = project.data;

const pageTitle = `${title} – ${SITE.shortName}`;
const pageUrl = new URL(`/projects/${project.id}/`, SITE.url).href;

const projectLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: title,
  description: tagline,
  url: pageUrl,
  ...(repo ? { codeRepository: repo } : {}),
  programmingLanguage: 'Python',
  author: { '@id': PERSON_ID, '@type': 'Person', name: SITE.name, url: `${SITE.url}/` },
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects/', SITE.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const statusLabel =
  status === 'private' ? 'Private, results de-identified' :
  status === 'research' ? 'Research' : 'Open source';
---

<Base title={pageTitle} description={tagline} ogType="article" jsonLd={[projectLd, breadcrumbLd]}>
  <article class="wrap rail project-page">
    <nav class="rail-main breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href="/projects/">Projects</a> / <span>{title}</span>
    </nav>

    <aside class="rail-side toc-col">
      {sections.length > 0 && (
        <nav class="toc" aria-label="Contents">
          <p class="toc-title">Contents</p>
          <ol>
            <li><a href="#overview">Overview</a></li>
            {sections.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
          </ol>
        </nav>
      )}
    </aside>

    <header class="rail-main page-head">
      <h1>{title}</h1>
      <p class="lead justify">{tagline}</p>
      <p class="facts-line">
        <span class="area">{DOMAINS[domain]}</span>. {statusLabel}. {stack.join(', ')}
      </p>
      <div class="figures">
        {stats.map((s) => (
          <span><span class="v">{s.value}</span><span class="l">{s.label}</span></span>
        ))}
      </div>
      {repo && (
        <div class="actions">
          <a class="btn" href={repo} target="_blank" rel="noopener noreferrer">View source on GitHub ↗</a>
        </div>
      )}
    </header>

    <div class="rail-main prose body" id="overview">
      <Content />
      <div class="actions"><a class="btn ghost" href="/projects/">All projects</a></div>
    </div>
  </article>
</Base>

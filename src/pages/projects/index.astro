---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectItem from '../../components/ProjectItem.astro';
import { SITE, DOMAINS, PERSON_ID } from '../../config';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

// One section per area, in the order DOMAINS lists them; empty areas are skipped.
const groups = Object.entries(DOMAINS)
  .map(([key, label]) => ({ key, label, items: projects.filter((p) => p.data.domain === key) }))
  .filter((g) => g.items.length > 0);

const title = `Projects – ${SITE.shortName}`;
const description =
  'Projects across geospatial statistics (MGWR, GWPCA, spatial ML), urban analytics for 31 US cities, option-implied VaR forecasting, and reproducible engineering toolkits.';

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: title,
  description,
  url: new URL('/projects/', SITE.url).href,
  author: { '@id': PERSON_ID, '@type': 'Person', name: SITE.name, url: `${SITE.url}/` },
  hasPart: projects.map((p) => ({
    '@type': 'CreativeWork',
    name: p.data.title,
    url: new URL(`/projects/${p.id}/`, SITE.url).href,
  })),
};
---

<Base title={title} description={description} jsonLd={[collectionLd]}>
  <header class="wrap rail page-head">
    <div class="rail-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Projects</span>
      </nav>
      <h1>Projects</h1>
      <p class="lead">
        {projects.length} projects in {groups.length} areas. Private work is shown at the method level.
      </p>
    </div>
  </header>

  {groups.map((g) => (
    <Section id={g.key} title={`${g.label} (${g.items.length})`}>
      <ul class="items projects">
        {g.items.map((p) => <ProjectItem project={p} showDomain={false} />)}
      </ul>
    </Section>
  ))}
</Base>

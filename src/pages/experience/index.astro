---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Entry from '../../components/Entry.astro';
import { SITE } from '../../config';
import { experience } from '../../data/profile';

const title = `Experience – ${SITE.shortName}`;
const description =
  'Career timeline of Zih-Jyun (Derek) Huang (黃子竣): macro research at CIER, market risk at CTBC and Foxconn, urban data science at Gensler Research Institute, incoming risk management MA at CTBC Bank.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Experience', item: new URL('/experience/', SITE.url).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[breadcrumbLd]}>
  <header class="wrap rail page-head">
    <div class="rail-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Experience</span>
      </nav>
      <h1>Experience</h1>
    </div>
  </header>

  <Section title="Positions">
    <ul class="items timeline">
      {experience.map((e) => (
        <Entry
          when={e.when}
          title={e.org}
          sub={`${e.role}, ${e.where}`}
          note={e.note}
          attachments={e.attachments}
        />
      ))}
    </ul>
  </Section>
</Base>

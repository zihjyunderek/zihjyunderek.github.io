---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Entry from '../../components/Entry.astro';
import { SITE } from '../../config';
import { education, certificates, skillGroups } from '../../data/profile';

const title = `Skills – ${SITE.shortName}`;
const description =
  'Skills, methods, and qualifications of Zih-Jyun (Derek) Huang: spatial statistics (MGWR, GWPCA), Value-at-Risk and quantile regression, machine learning, Python and R; M.S. Money and Banking (NCCU), B.A. Economics (NTU).';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Skills', item: new URL('/skills/', SITE.url).href },
  ],
};
---

<Base title={title} description={description} jsonLd={[breadcrumbLd]}>
  <header class="wrap rail page-head">
    <div class="rail-main">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <span>Skills</span>
      </nav>
      <h1>Skills</h1>
    </div>
  </header>

  <Section title="Education">
    <ul class="items timeline">
      {education.map((e) => (
        <Entry
          when={e.when}
          title={e.school}
          sub={`${e.degree}, ${e.detail}`}
          note={e.thesis ? `Thesis: ${e.thesis}` : undefined}
          attachments={e.attachments}
        />
      ))}
    </ul>
  </Section>

  <Section title="Methods and tools">
    <dl class="pairs">
      {skillGroups.map((g) => (
        <div><dt>{g.name}</dt><dd>{g.items}</dd></div>
      ))}
    </dl>
  </Section>

  <Section title="Certificates">
    <ul class="items certs">
      {certificates.map((c) => (
        <li>
          <h3>{c.name}</h3>
          <p class="link-row">
            {c.attachments.map((a) => (
              <a href={a.href} target="_blank" rel="noopener">{a.label}</a>
            ))}
          </p>
        </li>
      ))}
    </ul>
  </Section>
</Base>

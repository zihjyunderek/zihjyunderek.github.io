---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectItem from '../components/ProjectItem.astro';
import Entry from '../components/Entry.astro';
import { SITE, PERSON_ID, WEBSITE_ID } from '../config';
import { experience, status, skillGroups } from '../data/profile';

const allProjects = await getCollection('projects');
const totalProjects = allProjects.length;

// Home lists the three core projects: featured first, then by sort order.
const sorted = [...allProjects].sort((a, b) => a.data.order - b.data.order);
const featured = [
  ...sorted.filter((p) => p.data.featured),
  ...sorted.filter((p) => !p.data.featured),
].slice(0, 3);

// Home page shows only a teaser of experience; full list lives at /experience/.
const recentExperience = experience.slice(0, 3);
const totalExperience = experience.length;

/* One Person node, addressed by a stable @id, is what a crawler needs to
   treat "Zih-Jyun Huang", "Derek Huang", and the Chinese legal name as the
   same entity. WebSite and ProfilePage point at it instead of repeating it. */
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': PERSON_ID,
  name: SITE.name,
  alternateName: [SITE.alternateName, SITE.shortName],
  jobTitle: SITE.jobTitle,
  description: SITE.description,
  image: new URL('/images/head.jpg', SITE.url).href,
  ...(SITE.org ? { worksFor: { '@type': 'Organization', name: SITE.org } } : {}),
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'National Chengchi University' },
    { '@type': 'CollegeOrUniversity', name: 'National Taiwan University' },
  ],
  knowsAbout: [
    'Spatial statistics',
    'Urban analytics',
    'Quantitative risk management',
    'Value at Risk',
    'Machine learning',
  ],
  knowsLanguage: ['zh-Hant', 'en'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Taipei',
    addressCountry: 'TW',
  },
  email: `mailto:${SITE.email}`,
  url: `${SITE.url}/`,
  sameAs: [SITE.github, SITE.linkedin].filter(Boolean),
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE.shortName,
  alternateName: [SITE.name, SITE.alternateName],
  url: `${SITE.url}/`,
  inLanguage: 'en',
  author: { '@id': PERSON_ID },
  publisher: { '@id': PERSON_ID },
};

/* ProfilePage is the type Google documents for a page that is about one
   person. It names the Person as the page's main entity, so the home page
   itself is read as the profile rather than as a generic landing page. */
const profilePageLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${SITE.url}/#profile`,
  url: `${SITE.url}/`,
  name: SITE.title,
  inLanguage: 'en',
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': PERSON_ID },
};
---

<Base jsonLd={[personLd, websiteLd, profilePageLd]}>

  <!-- Introduction: square portrait in the rail; the text column spans its height -->
  <section class="wrap rail intro" id="profile">
    <div class="rail-side">
      <img
        class="portrait"
        src="/images/head.jpg"
        alt="Derek Huang at Top of the Rock, New York"
        width="480"
        height="480"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="rail-main">
      <div>
        <h1>{SITE.name}</h1>
        <p class="title">{SITE.jobTitle}</p>
        <p class="degrees">
          M.S. Money and Banking, National Chengchi University (NCCU)<br />
          B.A. Economics, National Taiwan University (NTU)
        </p>
      </div>
      <div>
        <dl class="status">
          {status.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.text}</dd>
              <dd class="num">{s.when}</dd>
            </div>
          ))}
        </dl>
        <div class="actions">
          <a class="btn" href="/projects/">Projects ({totalProjects})</a>
          <a class="btn ghost" href="/cv/ZihJyunHuang_CV_en.pdf" target="_blank" rel="noopener">CV</a>
          <a class="btn ghost" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          {SITE.linkedin && <a class="btn ghost" href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}
        </div>
      </div>
    </div>
  </section>

  <Section id="projects" title="Selected projects">
    <ul class="items projects">
      {featured.map((p) => <ProjectItem project={p} />)}
    </ul>
    <div class="actions"><a class="btn ghost" href="/projects/">All {totalProjects} projects</a></div>
  </Section>

  <Section id="experience" title="Experience">
    <ul class="items timeline">
      {recentExperience.map((e) => (
        <Entry when={e.when} title={e.org} sub={`${e.role}, ${e.where}`} />
      ))}
    </ul>
    <div class="actions"><a class="btn ghost" href="/experience/">Full experience ({totalExperience})</a></div>
  </Section>

  <Section id="skills" title="Skills">
    <dl class="pairs">
      {skillGroups.map((g) => (
        <div><dt>{g.name}</dt><dd>{g.items}</dd></div>
      ))}
    </dl>
    <div class="actions"><a class="btn ghost" href="/skills/">Education and certificates</a></div>
  </Section>

  <Section id="contact" title="Contact">
    <ul class="contact-list">
      <li><strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      <li><strong>GitHub:</strong> <a href={SITE.github} target="_blank" rel="noopener noreferrer">{SITE.github.replace('https://', '')}</a></li>
      {SITE.linkedin && (
        <li><strong>LinkedIn:</strong> <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">{SITE.linkedin.replace('https://www.', '').replace(/\/$/, '')}</a></li>
      )}
    </ul>
  </Section>

</Base>
